PORT=3000
MONGODB_URI=mongodb://localhost:27017/trama
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200
# URL del frontend, para los links de los emails de notificación.
APP_URL=http://localhost:4200
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email (Brevo HTTP API). Sin BREVO_API_KEY los correos se loguean en vez de enviarse.
# MAIL_FROM debe ser el remitente verificado en Brevo.
BREVO_API_KEY=
MAIL_FROM=Trama <trama.moda.circular@gmail.com>
# Casilla que recibe los tickets de /ayuda/contacto (si falta, se usa la de MAIL_FROM).
SUPPORT_EMAIL=trama.moda.circular@gmail.com
